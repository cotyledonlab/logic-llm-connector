{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cotyledonlab.dev/logic-llm-connector/schemas/logic-bridge.schema.json",
  "title": "Logic Bridge Protocol",
  "description": "Versioned JSON-RPC messages exchanged across the MCP/native seam.",
  "$defs": {
    "jsonRpcId": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer" }
      ]
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "evidence": {
      "type": "object",
      "required": ["source", "observedAt", "value"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "value": true
      },
      "additionalProperties": false
    },
    "doctorCheck": {
      "type": "object",
      "required": ["id", "status", "summary", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["passed", "warning", "failed", "unknown"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "additionalProperties": false
    },
    "doctorData": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/doctorCheck" }
        }
      },
      "additionalProperties": false
    },
    "axNode": {
      "type": "object",
      "required": [
        "id",
        "parentId",
        "role",
        "subrole",
        "identifier",
        "enabled",
        "focused",
        "childCount"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parentId": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "role": { "type": "string", "minLength": 1 },
        "subrole": { "type": ["string", "null"] },
        "identifier": { "type": ["string", "null"] },
        "enabled": { "type": ["boolean", "null"] },
        "focused": { "type": ["boolean", "null"] },
        "childCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "axSnapshotData": {
      "type": "object",
      "required": [
        "application",
        "capturedAt",
        "limits",
        "truncated",
        "nodes"
      ],
      "properties": {
        "application": {
          "type": "object",
          "required": ["bundleIdentifier", "pid"],
          "properties": {
            "bundleIdentifier": { "const": "com.apple.logic10" },
            "pid": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "capturedAt": { "type": "string", "format": "date-time" },
        "limits": {
          "type": "object",
          "required": ["maxDepth", "maxNodes"],
          "properties": {
            "maxDepth": { "type": "integer", "minimum": 0, "maximum": 8 },
            "maxNodes": { "type": "integer", "minimum": 1, "maximum": 1000 }
          },
          "additionalProperties": false
        },
        "truncated": { "type": "boolean" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/axNode" },
          "maxItems": 1000
        }
      },
      "additionalProperties": false
    },
    "transportStateData": {
      "type": "object",
      "required": ["playing", "cycle", "recordReady", "observedAt"],
      "properties": {
        "playing": { "enum": ["playing", "stopped", "unknown"] },
        "cycle": { "enum": ["enabled", "disabled", "unknown"] },
        "recordReady": { "enum": ["ready", "not_ready", "unknown"] },
        "observedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "transportOperationData": {
      "type": "object",
      "required": ["requestedState", "commandDispatched", "state"],
      "properties": {
        "requestedState": { "enum": ["playing", "stopped"] },
        "commandDispatched": { "type": "boolean" },
        "state": { "$ref": "#/$defs/transportStateData" }
      },
      "additionalProperties": false
    },
    "transportPositionData": {
      "type": "object",
      "required": ["display", "observedAt"],
      "properties": {
        "display": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9]{10}$" },
            { "type": "null" }
          ]
        },
        "observedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "transportLocationOperationData": {
      "type": "object",
      "required": [
        "requestedDirection",
        "steps",
        "commandDispatched",
        "initialPosition",
        "position"
      ],
      "properties": {
        "requestedDirection": { "enum": ["backward", "forward"] },
        "steps": { "type": "integer", "minimum": 1, "maximum": 100 },
        "commandDispatched": { "type": "boolean" },
        "initialPosition": { "$ref": "#/$defs/transportPositionData" },
        "position": { "$ref": "#/$defs/transportPositionData" }
      },
      "additionalProperties": false
    },
    "transportLocateOperationData": {
      "type": "object",
      "required": [
        "requestedTarget",
        "commandDispatched",
        "initialPosition",
        "position"
      ],
      "properties": {
        "requestedTarget": { "const": "project_start" },
        "commandDispatched": { "type": "boolean" },
        "initialPosition": { "$ref": "#/$defs/transportPositionData" },
        "position": { "$ref": "#/$defs/transportPositionData" }
      },
      "additionalProperties": false
    },
    "operationResult": {
      "type": "object",
      "required": [
        "protocolVersion",
        "operationId",
        "status",
        "reliability",
        "startedAt",
        "finishedAt",
        "data",
        "evidence"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "operationId": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["succeeded", "partial", "failed", "cancelled", "timed_out"]
        },
        "reliability": {
          "enum": [
            "verified_deterministic",
            "verified_ui_driven",
            "best_effort",
            "unsupported"
          ]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/doctorData" },
            { "$ref": "#/$defs/axSnapshotData" },
            { "$ref": "#/$defs/transportStateData" },
            { "$ref": "#/$defs/transportOperationData" },
            { "$ref": "#/$defs/transportLocationOperationData" },
            { "$ref": "#/$defs/transportLocateOperationData" }
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "succeeded" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidence": { "type": "array", "minItems": 1 } }
          }
        }
      ],
      "additionalProperties": false
    },
    "doctorRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.doctor" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "inspectUIRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.inspectUI" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId", "maxDepth", "maxNodes"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 },
            "maxDepth": { "type": "integer", "minimum": 0, "maximum": 8 },
            "maxNodes": { "type": "integer", "minimum": 1, "maximum": 1000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transportStateRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.transport.state" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transportSetPlayingRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.transport.setPlaying" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId", "playing", "timeoutMs"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 },
            "playing": { "type": "boolean" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 5000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transportMovePlayheadRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.transport.movePlayhead" },
        "params": {
          "type": "object",
          "required": [
            "protocolVersion",
            "operationId",
            "direction",
            "steps",
            "timeoutMs"
          ],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 },
            "direction": { "enum": ["backward", "forward"] },
            "steps": { "type": "integer", "minimum": 1, "maximum": 100 },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 5000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transportLocateRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.transport.locate" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId", "target", "timeoutMs"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 },
            "target": { "const": "project_start" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 5000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "request": {
      "oneOf": [
        { "$ref": "#/$defs/doctorRequest" },
        { "$ref": "#/$defs/inspectUIRequest" },
        { "$ref": "#/$defs/transportStateRequest" },
        { "$ref": "#/$defs/transportSetPlayingRequest" },
        { "$ref": "#/$defs/transportMovePlayheadRequest" },
        { "$ref": "#/$defs/transportLocateRequest" }
      ]
    },
    "response": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "result": { "$ref": "#/$defs/operationResult" }
      },
      "additionalProperties": false
    }
  }
}
