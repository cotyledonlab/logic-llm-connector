{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cotyledonlab.dev/logic-llm-connector/schemas/logic-bridge.schema.json",
  "title": "Logic Bridge Protocol",
  "description": "Versioned JSON-RPC messages exchanged across the MCP/native seam.",
  "$defs": {
    "jsonRpcId": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer" }
      ]
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "evidence": {
      "type": "object",
      "required": ["source", "observedAt", "value"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "value": true
      },
      "additionalProperties": false
    },
    "doctorCheck": {
      "type": "object",
      "required": ["id", "status", "summary", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["passed", "warning", "failed", "unknown"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "additionalProperties": false
    },
    "doctorData": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/doctorCheck" }
        }
      },
      "additionalProperties": false
    },
    "operationResult": {
      "type": "object",
      "required": [
        "protocolVersion",
        "operationId",
        "status",
        "reliability",
        "startedAt",
        "finishedAt",
        "data",
        "evidence"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "operationId": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["succeeded", "partial", "failed", "cancelled", "timed_out"]
        },
        "reliability": {
          "enum": [
            "verified_deterministic",
            "verified_ui_driven",
            "best_effort",
            "unsupported"
          ]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "data": { "$ref": "#/$defs/doctorData" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "succeeded" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidence": { "type": "array", "minItems": 1 } }
          }
        }
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.doctor" },
        "params": {
          "type": "object",
          "required": ["protocolVersion"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "result": { "$ref": "#/$defs/operationResult" }
      },
      "additionalProperties": false
    }
  }
}
