{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cotyledonlab.dev/logic-llm-connector/schemas/logic-bridge.schema.json",
  "title": "Logic Bridge Protocol",
  "description": "Versioned JSON-RPC messages exchanged across the MCP/native seam.",
  "$defs": {
    "jsonRpcId": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer" }
      ]
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "evidence": {
      "type": "object",
      "required": ["source", "observedAt", "value"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "value": true
      },
      "additionalProperties": false
    },
    "doctorCheck": {
      "type": "object",
      "required": ["id", "status", "summary", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["passed", "warning", "failed", "unknown"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "additionalProperties": false
    },
    "doctorData": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/doctorCheck" }
        }
      },
      "additionalProperties": false
    },
    "axNode": {
      "type": "object",
      "required": [
        "id",
        "parentId",
        "role",
        "subrole",
        "identifier",
        "enabled",
        "focused",
        "childCount"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parentId": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "role": { "type": "string", "minLength": 1 },
        "subrole": { "type": ["string", "null"] },
        "identifier": { "type": ["string", "null"] },
        "enabled": { "type": ["boolean", "null"] },
        "focused": { "type": ["boolean", "null"] },
        "childCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "axSnapshotData": {
      "type": "object",
      "required": [
        "application",
        "capturedAt",
        "limits",
        "truncated",
        "nodes"
      ],
      "properties": {
        "application": {
          "type": "object",
          "required": ["bundleIdentifier", "pid"],
          "properties": {
            "bundleIdentifier": { "const": "com.apple.logic10" },
            "pid": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "capturedAt": { "type": "string", "format": "date-time" },
        "limits": {
          "type": "object",
          "required": ["maxDepth", "maxNodes"],
          "properties": {
            "maxDepth": { "type": "integer", "minimum": 0, "maximum": 8 },
            "maxNodes": { "type": "integer", "minimum": 1, "maximum": 1000 }
          },
          "additionalProperties": false
        },
        "truncated": { "type": "boolean" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/axNode" },
          "maxItems": 1000
        }
      },
      "additionalProperties": false
    },
    "transportStateData": {
      "type": "object",
      "required": ["playing", "cycle", "recordReady", "observedAt"],
      "properties": {
        "playing": { "enum": ["playing", "stopped", "unknown"] },
        "cycle": { "enum": ["enabled", "disabled", "unknown"] },
        "recordReady": { "enum": ["ready", "not_ready", "unknown"] },
        "observedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "transportOperationData": {
      "type": "object",
      "required": ["requestedState", "commandDispatched", "state"],
      "properties": {
        "requestedState": { "enum": ["playing", "stopped"] },
        "commandDispatched": { "type": "boolean" },
        "state": { "$ref": "#/$defs/transportStateData" }
      },
      "additionalProperties": false
    },
    "transportPositionData": {
      "type": "object",
      "required": ["display", "observedAt"],
      "properties": {
        "display": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9]{10}$" },
            { "type": "null" }
          ]
        },
        "observedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "transportLocationOperationData": {
      "type": "object",
      "required": [
        "requestedDirection",
        "steps",
        "commandDispatched",
        "initialPosition",
        "position"
      ],
      "properties": {
        "requestedDirection": { "enum": ["backward", "forward"] },
        "steps": { "type": "integer", "minimum": 1, "maximum": 100 },
        "commandDispatched": { "type": "boolean" },
        "initialPosition": { "$ref": "#/$defs/transportPositionData" },
        "position": { "$ref": "#/$defs/transportPositionData" }
      },
      "additionalProperties": false
    },
    "transportLocateOperationData": {
      "type": "object",
      "required": [
        "requestedTarget",
        "commandDispatched",
        "initialPosition",
        "position"
      ],
      "properties": {
        "requestedTarget": { "const": "project_start" },
        "commandDispatched": { "type": "boolean" },
        "initialPosition": { "$ref": "#/$defs/transportPositionData" },
        "position": { "$ref": "#/$defs/transportPositionData" }
      },
      "additionalProperties": false
    },
    "projectIdentity": {
      "type": "object",
      "required": ["name", "path", "modified", "observedAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "modified": { "type": "boolean" },
        "observedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "projectLifecycleData": {
      "type": "object",
      "required": ["action", "commandDispatched", "policyContext", "cleanupPerformed"],
      "properties": {
        "action": { "enum": ["observe", "open", "save", "close", "reopen", "cleanup"] },
        "commandDispatched": { "type": "boolean" },
        "project": { "$ref": "#/$defs/projectIdentity" },
        "managedProjectPath": { "type": "string", "minLength": 1 },
        "policyContext": { "type": "boolean" },
        "cleanupPerformed": { "type": "boolean" },
        "failure": {
          "enum": [
            "fixture_not_found",
            "invalid_fixture",
            "user_project_open",
            "no_managed_project",
            "project_identity_changed",
            "unsaved_changes",
            "dialog_presented",
            "automation_denied",
            "command_failed",
            "postcondition_failed",
            "cleanup_failed"
          ]
        }
      },
      "additionalProperties": false
    },
    "trackIdentity": {
      "type": "object",
      "required": ["id", "position", "type", "name", "selected", "observedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "position": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["software_instrument", "audio", "external_midi", "unknown"] },
        "name": { "type": "string", "minLength": 1 },
        "selected": { "type": "boolean" },
        "observedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "trackOperationData": {
      "type": "object",
      "required": ["action", "commandDispatched", "policyContext", "undoAvailable", "tracks"],
      "properties": {
        "action": { "enum": ["observe", "create", "rename", "select", "duplicate", "reorder", "delete"] },
        "commandDispatched": { "type": "boolean" },
        "policyContext": { "type": "boolean" },
        "targetTrackId": { "type": "string", "minLength": 1 },
        "undoAvailable": { "type": "boolean" },
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/trackIdentity" } },
        "failure": {
          "enum": [
            "project_policy_missing", "test_mode_inactive", "accessibility_unavailable",
            "logic_not_running", "logic_not_focused", "track_not_found",
            "unsupported_track_type", "invalid_name", "invalid_position",
            "confirmation_required", "dialog_presented", "command_failed",
            "postcondition_failed", "undo_unavailable"
          ]
        }
      },
      "additionalProperties": false
    },
    "musicalTime": {
      "type": "object",
      "required": ["ticks", "ppq"],
      "properties": {
        "ticks": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "ppq": { "const": 960 }
      },
      "additionalProperties": false
    },
    "musicalDuration": {
      "type": "object",
      "required": ["ticks", "ppq"],
      "properties": {
        "ticks": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "ppq": { "const": 960 }
      },
      "additionalProperties": false
    },
    "midiNoteContent": {
      "type": "object",
      "required": ["pitch", "onset", "duration", "velocity", "channel"],
      "properties": {
        "pitch": { "type": "integer", "minimum": 0, "maximum": 127 },
        "onset": { "$ref": "#/$defs/musicalTime" },
        "duration": { "$ref": "#/$defs/musicalDuration" },
        "velocity": { "type": "integer", "minimum": 1, "maximum": 127 },
        "channel": { "type": "integer", "minimum": 1, "maximum": 16 }
      },
      "additionalProperties": false
    },
    "midiNoteIdentity": {
      "type": "object",
      "required": ["id", "pitch", "onset", "duration", "velocity", "channel"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pitch": { "type": "integer", "minimum": 0, "maximum": 127 },
        "onset": { "$ref": "#/$defs/musicalTime" },
        "duration": { "$ref": "#/$defs/musicalDuration" },
        "velocity": { "type": "integer", "minimum": 1, "maximum": 127 },
        "channel": { "type": "integer", "minimum": 1, "maximum": 16 }
      },
      "additionalProperties": false
    },
    "midiRegionIdentity": {
      "type": "object",
      "required": ["id", "trackId", "name", "position", "length", "notes", "selected", "active", "observedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "trackId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "position": { "$ref": "#/$defs/musicalTime" },
        "length": { "$ref": "#/$defs/musicalDuration" },
        "notes": { "type": "array", "items": { "$ref": "#/$defs/midiNoteIdentity" }, "maxItems": 100000 },
        "selected": { "type": "boolean" },
        "active": { "type": "boolean" },
        "observedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "midiFidelityDifference": {
      "type": "object",
      "required": ["field", "requested", "observed", "reason"],
      "properties": {
        "targetId": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "requested": true,
        "observed": true,
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "midiRegionOperationData": {
      "type": "object",
      "required": ["action", "commandDispatched", "policyContext", "createdRegionIds", "exactFidelity", "fidelityDifferences", "playbackVerified", "undoAvailable", "regions"],
      "properties": {
        "action": { "enum": ["observe", "create", "rename", "move", "resize", "duplicate", "split", "update_note", "replace_notes", "delete", "verify_playback"] },
        "commandDispatched": { "type": "boolean" },
        "policyContext": { "type": "boolean" },
        "targetRegionId": { "type": "string", "minLength": 1 },
        "createdRegionIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exactFidelity": { "type": "boolean" },
        "fidelityDifferences": { "type": "array", "items": { "$ref": "#/$defs/midiFidelityDifference" } },
        "playbackVerified": { "type": "boolean" },
        "undoAvailable": { "type": "boolean" },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/midiRegionIdentity" } },
        "failure": {
          "enum": [
            "project_policy_missing", "test_mode_inactive", "accessibility_unavailable",
            "logic_not_running", "logic_not_focused", "track_not_found", "region_not_found",
            "note_not_found", "invalid_musical_time", "invalid_note", "invalid_name",
            "invalid_split_position", "confirmation_required", "dialog_presented",
            "command_failed", "postcondition_failed", "undo_unavailable", "playback_not_observed"
          ]
        }
      },
      "additionalProperties": false
    },
    "operationResult": {
      "type": "object",
      "required": [
        "protocolVersion",
        "operationId",
        "status",
        "reliability",
        "startedAt",
        "finishedAt",
        "data",
        "evidence"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "operationId": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["succeeded", "partial", "failed", "cancelled", "timed_out"]
        },
        "reliability": {
          "enum": [
            "verified_deterministic",
            "verified_ui_driven",
            "best_effort",
            "unsupported"
          ]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/doctorData" },
            { "$ref": "#/$defs/axSnapshotData" },
            { "$ref": "#/$defs/transportStateData" },
            { "$ref": "#/$defs/transportOperationData" },
            { "$ref": "#/$defs/transportLocationOperationData" },
            { "$ref": "#/$defs/transportLocateOperationData" },
            { "$ref": "#/$defs/projectLifecycleData" },
            { "$ref": "#/$defs/trackOperationData" },
            { "$ref": "#/$defs/midiRegionOperationData" }
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "succeeded" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidence": { "type": "array", "minItems": 1 } }
          }
        }
      ],
      "additionalProperties": false
    },
    "doctorRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.doctor" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "inspectUIRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.inspectUI" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId", "maxDepth", "maxNodes"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 },
            "maxDepth": { "type": "integer", "minimum": 0, "maximum": 8 },
            "maxNodes": { "type": "integer", "minimum": 1, "maximum": 1000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transportStateRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.transport.state" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transportSetPlayingRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.transport.setPlaying" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId", "playing", "timeoutMs"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 },
            "playing": { "type": "boolean" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 5000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transportMovePlayheadRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.transport.movePlayhead" },
        "params": {
          "type": "object",
          "required": [
            "protocolVersion",
            "operationId",
            "direction",
            "steps",
            "timeoutMs"
          ],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 },
            "direction": { "enum": ["backward", "forward"] },
            "steps": { "type": "integer", "minimum": 1, "maximum": 100 },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 5000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transportLocateRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.transport.locate" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId", "target", "timeoutMs"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 },
            "target": { "const": "project_start" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 5000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "projectStateRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.project.state" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "projectOpenRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.project.openFixture" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId", "fixturePath", "timeoutMs"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 },
            "fixturePath": { "type": "string", "minLength": 1 },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "projectMutationRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": {
          "enum": ["logic.project.save", "logic.project.close", "logic.project.reopen", "logic.project.cleanup"]
        },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId", "timeoutMs"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "trackStateRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.tracks.state" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "trackMutationRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": {
          "enum": [
            "logic.tracks.create", "logic.tracks.rename", "logic.tracks.select",
            "logic.tracks.duplicate", "logic.tracks.reorder", "logic.tracks.delete"
          ]
        },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId", "timeoutMs"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 },
            "trackId": { "type": "string", "minLength": 1 },
            "type": { "enum": ["software_instrument", "audio", "external_midi"] },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "position": { "type": "integer", "minimum": 1 },
            "confirm": { "type": "boolean" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 10000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "midiRegionStateRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "const": "logic.midiRegions.state" },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "midiRegionMutationRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": {
          "enum": [
            "logic.midiRegions.create", "logic.midiRegions.rename", "logic.midiRegions.move",
            "logic.midiRegions.resize", "logic.midiRegions.duplicate", "logic.midiRegions.split",
            "logic.midiRegions.updateNote", "logic.midiRegions.replaceNotes",
            "logic.midiRegions.delete", "logic.midiRegions.verifyPlayback"
          ]
        },
        "params": {
          "type": "object",
          "required": ["protocolVersion", "operationId", "timeoutMs"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
            "operationId": { "type": "string", "minLength": 1 },
            "trackId": { "type": "string", "minLength": 1 },
            "regionId": { "type": "string", "minLength": 1 },
            "noteId": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "position": { "$ref": "#/$defs/musicalTime" },
            "length": { "$ref": "#/$defs/musicalDuration" },
            "note": { "$ref": "#/$defs/midiNoteContent" },
            "notes": { "type": "array", "items": { "$ref": "#/$defs/midiNoteContent" }, "maxItems": 10000 },
            "confirm": { "type": "boolean" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "request": {
      "oneOf": [
        { "$ref": "#/$defs/doctorRequest" },
        { "$ref": "#/$defs/inspectUIRequest" },
        { "$ref": "#/$defs/transportStateRequest" },
        { "$ref": "#/$defs/transportSetPlayingRequest" },
        { "$ref": "#/$defs/transportMovePlayheadRequest" },
        { "$ref": "#/$defs/transportLocateRequest" },
        { "$ref": "#/$defs/projectStateRequest" },
        { "$ref": "#/$defs/projectOpenRequest" },
        { "$ref": "#/$defs/projectMutationRequest" },
        { "$ref": "#/$defs/trackStateRequest" },
        { "$ref": "#/$defs/trackMutationRequest" },
        { "$ref": "#/$defs/midiRegionStateRequest" },
        { "$ref": "#/$defs/midiRegionMutationRequest" }
      ]
    },
    "response": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "result": { "$ref": "#/$defs/operationResult" }
      },
      "additionalProperties": false
    }
  }
}
